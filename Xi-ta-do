-- Função para criar botão toggle FF Style
local function makeBtn(txt, y, cb)
    local b = Instance.new("TextButton", scr); b.Size=UDim2.new(0.9,0,0,35); b.Position=UDim2.new(0.05,0,0,y); b.Text=txt.."  [ OFF ]"; b.BackgroundColor3=FF.Btn; b.TextColor3=Color3.fromRGB(200,200,200); b.Font=Enum.Font.GothamBold; b.TextSize=13; b.TextXAlignment=Enum.TextXAlignment.Left
    local pad = Instance.new("UIPadding", b); pad.PaddingLeft = UDim.new(0,10)
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    
    local on = false
    b.MouseButton1Click:Connect(function()
        on=not on
        b.Text=txt..(on and "  [ ON ]" or "  [ OFF ]")
        b.BackgroundColor3=on and FF.On or FF.Btn
        b.TextColor3=on and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,200)
        if cb then cb(on) end
    end)
end

