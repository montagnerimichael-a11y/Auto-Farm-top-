    end
    
    if c.Fly then
        hu.PlatformStand = true
        if not bv then 
            bv = Instance.new("BodyVelocity", rt)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge); bv.P = 10000
        end
        local move = hu.MoveDirection * c.Vel
        bv.Velocity = Vector3.new(move.X, 50, move.Z)
    else
        if bv then bv:Destroy() bv=nil end
        if hu.PlatformStand then hu.PlatformStand = false end
    end
    
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= P and p.Character then
            local pCh = p.Character
            local pHum = pCh:FindFirstChildOfClass("Humanoid")
            if pHum and pHum.Health > 0 then
                if c.ESP and not espTags[p] then
                    local hl = Instance.new("Highlight", pCh)
                    hl.FillColor = Color3.fromRGB(255,0,0); hl.FillTransparency = 0.5; hl.OutlineColor = Color3.fromRGB(255,255,255)
                    local bb = Instance.new("BillboardGui", pCh.Head)
                    bb.Size = UDim2.new(0,100,0,30); bb.AlwaysOnTop = true
                    local txt = Instance.new("TextLabel", bb)
                    txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1; txt.Text = p.Name; txt.TextColor3 = Color3.fromRGB(255,50,50); txt.TextStrokeTransparency = 0; txt.Font = Enum.Font.GothamBold; txt.TextSize = 14
                    espTags[p] = {hl=hl, bb=bb, txt=txt}
                elseif c.ESP and espTags[p] then
                    local dist = math.floor((rt.Position - pCh.Head.Position).Magnitude)
                    espTags[p].txt.Text = p.Name .. " [" .. dist .. "m]"
                elseif not c.ESP and espTags[p] then
                    espTags[p].hl:Destroy(); espTags[p].bb:Destroy(); espTags[p] = nil
                end
                
                local hrp = pCh:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if c.Hitbox then hrp.Size = Vector3.new(15, 15, 15); hrp.Transparency = 0.7; hrp.CanCollide = false
                    else hrp.Size = Vector3.new(2, 2, 1); hrp.Transparency = 1; hrp.CanCollide = true end
                end
            end
        end
    end
end)

