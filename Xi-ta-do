-- FUNÇÃO DE LIMPAR TUDO
local function DisableAll()
    for k, _ in pairs(c) do if type(c[k]) == "boolean" then c[k] = false end end
    uC()
    if hu then hu.WalkSpeed = 16; hu.JumpPower = 50; hu.UseJumpPower = false end
    if bv then bv:Destroy() bv = nil end
    L.Ambient = Color3.fromRGB(70,70,70); L.OutdoorAmbient = Color3.fromRGB(128,128,128); L.GlobalShadows = true
    
    for p, t in pairs(espTags) do
        if t.hl then t.hl:Destroy() end
        if t.bb then t.bb:Destroy() end
        espTags[p] = nil
    end
    
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= P and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Size = Vector3.new(2, 2, 1); hrp.Transparency = 1; hrp.CanCollide = true end
        end
    end
    
    for key, btn in pairs(toggles) do
        c[key] = false
        local baseText = string.split(btn.Text, "  [")[1]
        btn.Text = baseText .. "  [ OFF ]"
        btn.BackgroundColor3 = FF.Btn; btn.TextColor3 = Color3.fromRGB(150,150,150)
    end
end
