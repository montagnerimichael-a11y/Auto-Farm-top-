local function isVisible(target)
    local origin = Cam.CFrame.Position
    local direction = target.Position - origin
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {P.Character, target.Parent}
    local result = W:Raycast(origin, direction, rayParams)
    return result == nil 
end

local function getClosest()
    local closest, dist = nil, math.huge
    local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= P and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 then
            local head = p.Character.Head
            local screenPos, onScreen = Cam:WorldToViewportPoint(head.Position)
            if onScreen and isVisible(head) then
                local d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                if d < c.FOV and d < dist then dist = d; closest = head end
            end
        end
    end
    return closest
end

