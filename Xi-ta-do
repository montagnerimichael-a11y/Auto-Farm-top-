local function Notify(txt, isOn)
    for _, child in pairs(gui:GetChildren()) do
        if child.Name == "Notification" then child:Destroy() end
    end

    local notif = Instance.new("Frame", gui)
    notif.Name = "Notification"
    notif.Size = UDim2.new(0, 250, 0, 45)
    notif.Position = UDim2.new(0.5, -125, 0, -60)
    notif.BackgroundColor3 = isOn and Color3.fromRGB(60, 0, 0) or Color3.fromRGB(20, 20, 20)
    notif.BorderSizePixel = 0
    notif.ZIndex = 100
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = isOn and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(100, 100, 100)
    stroke.Thickness = 2

    local label = Instance.new("TextLabel", notif)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = txt
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBlack
    label.TextSize = 13
    label.ZIndex = 101

    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -125, 0, 50)}):Play()

    task.delay(3.5, function()
        if notif and notif.Parent then
            local tweenOut = TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -125, 0, -60)})
            tweenOut:Play()
            tweenOut.Completed:Connect(function() notif:Destroy() end)
        end
    end)
end

