-- Função para achar o jogador mais próximo na tela (Aimbot)
local function getClosest()
    local closest, dist = nil, math.huge
    local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= P and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 then
            local screenPos, onScreen = Cam:WorldToViewportPoint(p.Character.Head.Position)
            if onScreen then
                local d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                if d < c.FOV and d < dist then
                    dist = d
                    closest = p.Character.Head
                end
            end
        end
    end
    return closest
end

-- Loop do Aimbot (Suave, funciona em 1ª e 3ª pessoa)
lpA = R.RenderStepped:Connect(function()
    if c.Aimbot then
        local target = getClosest()
        if target then
            -- Lerp deixa a mira suave, sem "trancos"
            local targetCFrame = CFrame.new(Cam.CFrame.Position, target.Position)
            Cam.CFrame = Cam.CFrame:Lerp(targetCFrame, 0.3)
        end
    end
end)

-- Loop de Utilidades (Speed, Jump, ESP, Hitbox)
lpU = R.Heartbeat:Connect(function()
    uC()
    if not hu or not rt then return end
    
    if c.Spd then hu.WalkSpeed = c.Vel end
    if c.Jmp then hu.JumpPower = c.JumpPower; hu.UseJumpPower = true end
    if c.Full then L.Ambient = Color3.fromRGB(255,255,255); L.OutdoorAmbient = Color3.fromRGB(255,255,255); L.GlobalShadows = false end
    
    -- ESP e Hitbox
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= P and p.Character then
            local pCh = p.Character
            local pHum = pCh:FindFirstChildOfClass("Humanoid")
            if pHum and pHum.Health > 0 then
                -- ESP
                if c.ESP and not espTags[p] then
                    local hl = Instance.new("Highlight", pCh)
                    hl.FillColor = Color3.fromRGB(255,0,0)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255,255,255)
                    
                    local bb = Instance.new("BillboardGui", pCh.Head)
                    bb.Size = UDim2.new(0,100,0,30)
                    bb.AlwaysOnTop = true
                    bb.Name = "ESP_TAG"
                    local txt = Instance.new("TextLabel", bb)
                    txt.Size = UDim2.new(1,0,1,0)
                    txt.BackgroundTransparency = 1
                    txt.Text = p.Name
                    txt.TextColor3 = Color3.fromRGB(255,50,50)
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 14
                    
                    espTags[p] = {hl=hl, bb=bb, txt=txt}
                elseif c.ESP and espTags[p] then
                    local dist = math.floor((rt.Position - pCh.Head.Position).Magnitude)
                    espTags[p].txt.Text = p.Name .. " [" .. dist .. "m]"
                elseif not c.ESP and espTags[p] then
                    espTags[p].hl:Destroy()
                    espTags[p].bb:Destroy()
                    espTags[p] = nil
                end
                
                -- Hitbox Expander
                local hrp = pCh:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if c.Hitbox then
                        hrp.Size = Vector3.new(15, 15, 15)
                        hrp.Transparency = 0.7
                        hrp.CanCollide = false
                    else
                        hrp.Size = Vector3.new(2, 2, 1)
                        hrp.Transparency = 1
                        hrp.CanCollide = true
                    end
                end
            end
        end
    end
end)
