        statusKill.Text = "🔴 OFF"
        statusKill.TextColor3 = Color3.fromRGB(255, 100, 100)
        alvo = nil
        alvoText.Text = "🎯 Nenhum"
        alvoText.TextColor3 = Color3.fromRGB(200, 200, 200)
        
        if loopKill then
            loopKill:Disconnect()
            loopKill = nil
        end
    end
end

