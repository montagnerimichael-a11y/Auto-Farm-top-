-- ============================================
-- LOOP DE PERFORMANCE
-- ============================================

local ultimoFPS = tick()
local frames = 0

RunService.Heartbeat:Connect(function()
    frames = frames + 1
    if tick() - ultimoFPS >= 1 then
        local fps = frames
        frames = 0
        ultimoFPS = tick()
        
        if fps > 50 then
            performance.Text = "⚡ Performance: Excelente ("..fps.." FPS)"
            performance.TextColor3 = Color3.fromRGB(0, 255, 100)
        elseif fps > 30 then
            performance.Text = "⚡ Performance: Boa ("..fps.." FPS)"
            performance.TextColor3 = Color3.fromRGB(255, 200, 0)
        else
            performance.Text = "⚡ Performance: Baixa ("..fps.." FPS)"
            performance.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end
    
    if vivo() then
        statusVivo.Text = "❤️"
        statusVivo.TextColor3 = Color3.fromRGB(0, 255, 100)
        if not coletandoOrbes then
            local total = contarOrbes()
            if total > 0 then
                orbesDetect.Text = "🟢 Orbes: "..total
                orbesDetect.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                orbesDetect.Text = "🔴 Orbes: 0"
                orbesDetect.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
    else
        statusVivo.Text = "💀"
        statusVivo.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end)

