local function definirVelocidade(novaVelocidade)
    if not humanoid then return end
    
    velocidadeAtual = math.clamp(novaVelocidade, velocidadeMinima, velocidadeMaxima)
    humanoid.WalkSpeed = velocidadeAtual
    velocidadeLabel.Text = "🏃 Velocidade: " .. velocidadeAtual
    velocidadeValor.Text = velocidadeAtual
end

local function aumentarVelocidade()
    definirVelocidade(velocidadeAtual + incrementoVelocidade)
end

local function diminuirVelocidade()
    definirVelocidade(velocidadeAtual - incrementoVelocidade)
end

local function resetarVelocidade()
    definirVelocidade(16)
end

-- ===== SISTEMA DE OTIMIZAÇÃO GRÁFICA =====

local function salvarConfiguracoesOriginais()
    qualidadeOriginal = {
        brightness = Lighting.Brightness,
        clockTime = Lighting.ClockTime,
        fogEnd = Lighting.FogEnd,
        fogStart = Lighting.FogStart,
        globalShadows = Lighting.GlobalShadows,
        ambient = Lighting.Ambient,
        outdoorAmbient = Lighting.OutdoorAmbient,
        exposureCompensation = Lighting.ExposureCompensation
    }
end

local function otimizarGraficos()
    if otimizacaoAtiva then
        -- Restaurar configurações originais
        if qualidadeOriginal.brightness then
            Lighting.Brightness = qualidadeOriginal.brightness
            Lighting.ClockTime = qualidadeOriginal.clockTime
            Lighting.FogEnd = qualidadeOriginal.fogEnd
            Lighting.FogStart = qualidadeOriginal.fogStart
            Lighting.GlobalShadows = qualidadeOriginal.globalShadows
            Lighting.Ambient = qualidadeOriginal.ambient
            Lighting.OutdoorAmbient = qualidadeOriginal.outdoorAmbient
            Lighting.ExposureCompensation = qualidadeOriginal.exposureCompensation
        end
        
        -- Restaurar materiais
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj:GetAttribute("MaterialOriginal") then
                    obj.Material = Enum.Material[obj:GetAttribute("MaterialOriginal")]
                    obj:SetAttribute("MaterialOriginal", nil)
                end
            end
        end)
        
        otimizacaoAtiva = false
        print("🔄 Gráficos restaurados ao normal!")
    else
        -- Salvar configurações originais
        salvarConfiguracoesOriginais()
        
        -- Otimizar iluminação
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.FogStart = 50000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(160, 160, 160)
        Lighting.ExposureCompensation = 0.2
        
        -- Remover sombras e reflexos
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj:SetAttribute("MaterialOriginal", obj.Material.Name)
                    
                    if obj.Material == Enum.Material.Grass or 
                       obj.Material == Enum.Material.Fabric or
                       obj.Material == Enum.Material.WoodPlanks or
                       obj.Material == Enum.Material.Cobblestone then
                        obj.Material = Enum.Material.SmoothPlastic
                        texturasRemovidas = texturasRemovidas + 1
                    end
                    
                    if obj.Reflectance > 0 then
                        obj.Reflectance = 0
                    end
                end
                
                if obj:IsA("ParticleEmitter") then
                    obj.Enabled = false
                end
                
                if obj:IsA("Texture") or obj:IsA("Decal") then
                    obj.Transparency = 0.5
                end
            end
        end)
        
        otimizacaoAtiva = true
        print("⚡ Otimização gráfica ativada!")
        print("📊 Texturas otimizadas: "..texturasRemovidas)
    end
end

local function otimizarExtremo()
    Lighting.Brightness = 2
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000
    Lighting.FogStart = 50000
    
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            elseif obj:IsA("ParticleEmitter") then
                obj.Enabled = false
            elseif obj:IsA("Texture") or obj:IsA("Decal") then
                obj:Destroy()
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = ""
            end
        end
    end)
    
    print("🔥 Otimização EXTREMA ativada!")
end

-- ===== CLASSIFICAÇÃO DE OBJETOS =====
local function classificarObjeto(nome)
    nome = nome:lower()
    
    if nome:find("diamond") or nome:find("diamante") or nome:find("gem") or nome:find("crystal") then
        return "diamante"
    end
    
    if (nome:find("orb") or nome:find("esfera") or nome:find("bola")) then
        return "orbe"
    end
    
    return nil
end

