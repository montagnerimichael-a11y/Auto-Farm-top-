        end
        
        btnKill.Text = "⏹ PARAR"
        btnKill.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        statusKill.Text = "🟢 ON"
        statusKill.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        if loopKill then loopKill:Disconnect() end
