-- ============================================
-- FUNÇÕES OTIMIZADAS
-- ============================================

function vivo()
    return character and character.Parent and humanoid and humanoid.Health > 0
end

function acharEspada()
    if character then
        for _, obj in pairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                local nome = obj.Name:lower()
                if nome:find("sword") or nome:find("espada") or nome:find("katana") or nome:find("blade") then
                    espada = obj
                    return espada
                end
            end
        end
    end
    return nil
end

function acharAlvo()
    if not vivo() then return nil end
    local pos = rootPart.Position
    local melhor = nil
    local menorDistancia = 200
    
    for _, jogador in pairs(Players:GetPlayers()) do
        if jogador ~= player then
            local c = jogador.Character
            if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - pos).Magnitude
                    if d < menorDistancia then
                        menorDistancia = d
                        melhor = jogador
                    end
                end
            end
        end
    end
    return melhor
end

function contarOrbes()
    local count = 0
    local pos = rootPart.Position
    
    for _, obj in pairs(cacheObjetos) do
        if obj:IsA("BasePart") and classificarObjeto(obj.Name) == "orbe" then
            if obj.BrickColor and obj.BrickColor.Name:lower():find("white") then
                local d = (obj.Position - pos).Magnitude
                if d < raio + 100 then
                    count = count + 1
                end
            end
        end
    end
    return count
end

-- ===== COLETA OTIMIZADA =====

function coletar()
    if not vivo() then return end
    
    local pos = rootPart.Position
    local count = 0
    
    for _, obj in pairs(cacheObjetos) do
        if obj:IsA("BasePart") and classificarObjeto(obj.Name) == "diamante" then
            local dist = (obj.Position - pos).Magnitude
            if dist < raio then
                pcall(function()
                    obj.CFrame = rootPart.CFrame + Vector3.new(0, 1.5, 0)
                    Debris:AddItem(obj, 0.1)
                    count = count + 1
                end)
            end
        end
    end
    
    if count > 0 then
        diamantes = diamantes + count
        contador.Text = "💎"..diamantes.."  ⚔️"..kills.."  ⚪"..orbes
    end
end

function alternarColeta()
    if not vivo() then
        statusColeta.Text = "⚠️ Morto!"
        statusColeta.TextColor3 = Color3.fromRGB(255, 200, 0)
        wait(1)
        statusColeta.Text = "🔴 OFF"
        statusColeta.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    coletando = not coletando
    
    if coletando then
        btnColeta.Text = "⏹ PARAR"
        btnColeta.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        statusColeta.Text = "🟢 ON"
        statusColeta.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        if loopColeta then loopColeta:Disconnect() end
        loopColeta = RunService.Heartbeat:Connect(function()
            if coletando and vivo() then
                if atualizarCache() then
                    coletar()
                end
            end
        end)
    else
        btnColeta.Text = "💎 ATIVAR"
        btnColeta.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        statusColeta.Text = "🔴 OFF"
        statusColeta.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        if loopColeta then
            loopColeta:Disconnect()
            loopColeta = nil
        end
    end
end

-- ===== KILL OTIMIZADO =====

function loopKillFunc()
    if not matando then return end
    
    if not vivo() then
        matando = false
        btnKill.Text = "⚔️ ATIVAR"
        btnKill.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        statusKill.Text = "💀 MORTO"
        statusKill.TextColor3 = Color3.fromRGB(255, 100, 100)
        alvoText.Text = "🎯 Morto"
        alvoText.TextColor3 = Color3.fromRGB(200, 50, 50)
        if loopKill then
            loopKill:Disconnect()
            loopKill = nil
        end
        print("💀 Auto Kill desligado (personagem morreu)!")
        return
    end
    
    if not espada or not espada.Parent then
        acharEspada()
        if not espada then
            statusKill.Text = "⚠️ Sem espada!"
            statusKill.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(2)
            return
        end
    end
    
    if not alvo or not alvo.Character or alvo.Character.Humanoid.Health <= 0 then
        alvo = acharAlvo()
        if alvo then
            alvoText.Text = "🎯 " .. alvo.Name
            alvoText.TextColor3 = Color3.fromRGB(255, 50, 50)
        else
            alvoText.Text = "🎯 Nenhum"
            alvoText.TextColor3 = Color3.fromRGB(200, 200, 200)
            statusKill.Text = "🔍 Procurando..."
            statusKill.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(1)
            return
        end
    end
    
    if alvo and alvo.Character and alvo.Character.Humanoid.Health > 0 then
        local hrp = alvo.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local posAlvo = hrp.Position
            local posJogador = rootPart.Position
            local dist = (posAlvo - posJogador).Magnitude
            
            local cf = hrp.CFrame
            local costas = cf.LookVector * -1
            local posCostas = posAlvo + (costas * 2.5)
            
            if modoAgressivo then
                if dist > 20 then
                    local dir = (posAlvo - posJogador).Unit
                    rootPart.CFrame = rootPart.CFrame + (dir * 15)
                    statusKill.Text = "🏃 Correndo..."
                    statusKill.TextColor3 = Color3.fromRGB(255, 200, 0)
                    return
                end
                
                if dist > 3 then
                    local dir = (posAlvo - posJogador).Unit
                    rootPart.CFrame = rootPart.CFrame + (dir * 8)
                    statusKill.Text = "⚡ Investida..."
                    statusKill.TextColor3 = Color3.fromRGB(255, 150, 0)
                    return
                end
            else
                if dist > 20 then
                    local dir = (posAlvo - posJogador).Unit
                    rootPart.CFrame = rootPart.CFrame + (dir * 10)
                    statusKill.Text = "🏃 Correndo..."
                    statusKill.TextColor3 = Color3.fromRGB(255, 200, 0)
                    return
                end
                
                if dist > 4 then
                    local dirCostas = (posCostas - posJogador).Unit
                    rootPart.CFrame = rootPart.CFrame + (dirCostas * 5)
                    statusKill.Text = "🎯 Flanqueando..."
                    statusKill.TextColor3 = Color3.fromRGB(255, 200, 0)
                    return
                end
            end
            
            local olhar = CFrame.lookAt(rootPart.Position, posAlvo)
            rootPart.CFrame = CFrame.new(rootPart.Position, olhar.LookVector + rootPart.Position)
            
            pcall(function()
                espada:Activate()
                wait(0.05)
                espada:Activate()
                usarPoderes()
            end)
            
            kills = kills + 1
            contador.Text = "💎"..diamantes.."  ⚔️"..kills.."  ⚪"..orbes
            statusKill.Text = "⚔️ ATACANDO!"
            statusKill.TextColor3 = Color3.fromRGB(255, 0, 0)
            alvoText.Text = "🎯 " .. alvo.Name .. " 💀"
            alvoText.TextColor3 = Color3.fromRGB(255, 0, 0)
        end
    end
end

function alternarKill()
    if not vivo() then
        statusKill.Text = "⚠️ Morto!"
        statusKill.TextColor3 = Color3.fromRGB(255, 200, 0)
        wait(1)
        statusKill.Text = "🔴 OFF"
