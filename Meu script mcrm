-- ===== FUNÇÃO PARA USAR PODERES =====
local function usarPoderes()
    local teclas = {"Z", "X", "C", "V", "B", "F", "G"}
    for _, tecla in ipairs(teclas) do
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, tecla, false, game)
            wait(0.03)
            VirtualInputManager:SendKeyEvent(false, tecla, false, game)
        end)
    end
end

-- ===== SISTEMA ANTI-AFK =====

local function antiAFKFunc()
    if not antiAFKAtivo then return end
    
    -- Verifica se o jogador está vivo
    if not vivo() then return end
    
    -- Movimentos aleatórios para evitar AFK
    local movimentos = {
        function() -- Pula
            humanoid.Jump = true
        end,
        function() -- Move para esquerda
            rootPart.CFrame = rootPart.CFrame + Vector3.new(-2, 0, 0)
        end,
        function() -- Move para direita
            rootPart.CFrame = rootPart.CFrame + Vector3.new(2, 0, 0)
        end,
        function() -- Move para frente
            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 0, -2)
        end,
        function() -- Move para trás
            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 0, 2)
        end,
        function() -- Rotaciona
            rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(30), 0)
        end
    }
    
    -- Executa movimento aleatório
    local movimento = movimentos[math.random(1, #movimentos)]
    pcall(movimento)
    
    -- Simula pressionamento de teclas
    local teclas = {"W", "A", "S", "D", "Space"}
    local tecla = teclas[math.random(1, #teclas)]
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, tecla, false, game)
        wait(0.1)
        VirtualInputManager:SendKeyEvent(false, tecla, false, game)
    end)
    
    afkContador = afkContador + 1
end

local function alternarAntiAFK()
    antiAFKAtivo = not antiAFKAtivo
    
    if antiAFKAtivo then
        btnAntiAFK.Text = "🛡️ ANTI-AFK: ON"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        statusAntiAFK.Text = "🟢 Ativo"
        statusAntiAFK.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        -- Loop principal do Anti-AFK
        if loopAntiAFK then loopAntiAFK:Disconnect() end
        loopAntiAFK = RunService.Heartbeat:Connect(function()
            -- Executa a cada 30-60 segundos
            if tick() - ultimoMovimento > math.random(30, 60) then
                antiAFKFunc()
                ultimoMovimento = tick()
            end
        end)
        
        -- Também executa imediatamente
        antiAFKFunc()
        print("🛡️ Anti-AFK ativado!")
    else
        btnAntiAFK.Text = "🛡️ ANTI-AFK: OFF"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        statusAntiAFK.Text = "🔴 Inativo"
        statusAntiAFK.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        if loopAntiAFK then
            loopAntiAFK:Disconnect()
            loopAntiAFK = nil
        end
        print("🛡️ Anti-AFK desativado!")
    end
end

